# Copie para .env e preencha. NUNCA faça commit do .env.
TELEGRAM_TOKEN=           # token do bot (@BotFather)
TELEGRAM_CHAT_ID=         # seu chat_id (o do técnico)
TELEGRAM_SEGREDO_WEBHOOK= # uma senha qualquer, inventada por você
MODELO_IA=                # vazio = triagem simples; ex.: gemini/gemini-2.0-flash
USAR_GRAFO=               # 1 = ativa pipeline com Grafo de Conhecimento (GraphRAG)
GEMINI_API_KEY=           # chave da API Gemini (Google AI Studio)
ORIGENS_PERMITIDAS=*      # depois do deploy: https://SEU_USUARIO.github.io
